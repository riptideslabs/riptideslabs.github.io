---
// One project card: the repo name, its description, language and links.
import { languages, type Project } from "../data/projects";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { name, description, language, site, isNew } = project;
const repo = `https://github.com/riptideslabs/${name}`;
---

<article class="project">
  <h3>
    {name}
    {isNew && <span class="tag">New</span>}
  </h3>
  <p class="description">{description}</p>
  <div class="meta">
    <span class="language">
      <span class="swatch" style={`--swatch: ${languages[language]}`} aria-hidden="true"></span>
      {language}
    </span>
    <span class="links">
      <a href={repo} aria-label={`${name} on GitHub`}>
        <Icon name="github" />
        GitHub
      </a>
      {
        site && (
          <a href={site.href} aria-label={`${name} ${site.label.toLowerCase()}`}>
            <Icon name="external" />
            {site.label}
          </a>
        )
      }
    </span>
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.25rem 1rem;
    border: 1px solid var(--color-gray-5);
    border-radius: 0.5rem;
    transition: border-color 0.15s;
  }
  .project:hover {
    border-color: var(--color-gray-4);
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-white);
  }
  .tag {
    padding: 0.05rem 0.4rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 50%, transparent);
    border-radius: 0.25rem;
    font-family: var(--font);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-text-accent);
  }

  .description {
    flex: 1;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-gray-2);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
  }
  .language {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-gray-3);
  }
  .swatch {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--swatch);
  }
  .links {
    display: inline-flex;
    gap: 1rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 500;
    color: var(--color-text-accent);
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .links :global(svg) {
    width: 1rem;
    height: 1rem;
  }
</style>
