---
// The hero's swirl: rings ripple out from the Riptides mark. They stop for
// visitors who prefer reduced motion.
import Mark from "./Mark.astro";

const rings = [0, 1, 2, 3];
---

<div class="ripples" aria-hidden="true">
  <svg viewBox="0 0 400 400">
    <defs>
      <radialGradient id="rl-glow">
        <stop offset="0" class="glow-in"></stop>
        <stop offset="1" class="glow-out"></stop>
      </radialGradient>
      <linearGradient id="rl-mark" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" class="mark-from"></stop>
        <stop offset="1" class="mark-to"></stop>
      </linearGradient>
    </defs>
    <circle cx="200" cy="200" r="195" fill="url(#rl-glow)"></circle>
    <circle cx="200" cy="200" r="118" class="orbit"></circle>
    <circle cx="200" cy="200" r="168" class="orbit dashed"></circle>
    {rings.map((i) => <circle cx="200" cy="200" r="190" class="ring" style={`animation-delay: ${i * -2}s`}></circle>)}
  </svg>
  <Mark />
</div>

<style>
  .ripples {
    position: relative;
    width: min(60%, 13rem);
    margin-inline: auto;
    aspect-ratio: 1;
  }
  @media (min-width: 50rem) {
    .ripples { width: min(100%, 26rem); }
  }
  .ripples > svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ripples > :global(svg:last-child) {
    position: absolute;
    inset: 31%;
    width: 38%;
    height: 38%;
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--color-accent) 45%, transparent));
  }
  .ripples :global(svg:last-child path) {
    fill: url(#rl-mark);
  }

  .glow-in { stop-color: var(--color-accent); stop-opacity: var(--glow); }
  .glow-out { stop-color: var(--color-accent); stop-opacity: 0; }
  .mark-from { stop-color: var(--color-accent-high); }
  .mark-to { stop-color: var(--color-accent); }
  :global(:root[data-theme="light"]) .mark-from { stop-color: var(--color-accent); }
  :global(:root[data-theme="light"]) .mark-to { stop-color: var(--color-accent-high); }

  .orbit { fill: none; stroke: var(--color-accent); stroke-width: 1; opacity: 0.25; }
  .orbit.dashed { stroke-dasharray: 3 7; opacity: 0.3; }

  .ring {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: ripple 8s cubic-bezier(0.2, 0.6, 0.4, 1) infinite;
  }
  @keyframes ripple {
    0% { transform: scale(0.42); opacity: 0.7; }
    100% { transform: scale(1); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring { animation: none; }
  }
</style>
