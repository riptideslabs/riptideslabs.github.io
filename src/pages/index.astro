---
import "@fontsource-variable/inter";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Project from "../components/Project.astro";
import { projects } from "../data/projects";

const title = "Riptides Labs";
const description =
  "Open-source projects from Riptides for workload identity and secretless access: tokenex, Waterwheel, KeyLedger and more.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <script is:inline>
      // Starlight's theme key, shared with the project sites on this origin.
      try {
        var stored = localStorage.getItem("starlight-theme");
      } catch {}
      document.documentElement.dataset.theme =
        stored || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
    </script>
  </head>
  <body>
    <Header />
    <main>
      <Hero />
      <section id="projects" class="container projects">
        <h2>Projects</h2>
        <p class="intro">Libraries, tools and demos, all open source on GitHub.</p>
        <div class="grid">
          {projects.map((project) => <Project project={project} />)}
        </div>
      </section>
    </main>
    <footer class="container footer">
      <p>Riptides Labs is the open-source work of <a href="https://riptides.io">Riptides</a>.</p>
    </footer>
  </body>
</html>

<style>
  .projects {
    padding-block: 2rem 1rem;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.5rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    color: var(--color-white);
  }
  .intro {
    margin: 0.75rem 0 0;
    max-width: 40rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .footer {
    margin-top: 4rem;
    padding-block: 1.5rem 3rem;
  }
  .footer p {
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-gray-5);
    font-size: 0.875rem;
    color: var(--color-gray-3);
  }
</style>
